#!/usr/bin/env python3
import sys
import os
import argparse
import subprocess
import json
import datetime
import tempfile
import shutil

# Adjust path to import from scripts/
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import hashlib
from capture_adapters.m1a_adapters import ADAPTERS
from contract_fixture_lib import load_manifest, MANIFEST_PATH

def get_tool_version(args):
    try:
        res = subprocess.run(args, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return None

def publish_staged(staged_updates):
    """Replace all destinations, restoring originals if any publish step fails."""
    backups = []
    published = []
    try:
        for src, dst in staged_updates:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            backup = None
            if os.path.exists(dst):
                fd, backup = tempfile.mkstemp(prefix=".capture-backup-", dir=os.path.dirname(dst))
                os.close(fd)
                os.unlink(backup)
                os.replace(dst, backup)
            backups.append((dst, backup))
            os.replace(src, dst)
            published.append(dst)
    except Exception:
        for dst in reversed(published):
            try:
                os.unlink(dst)
            except FileNotFoundError:
                pass
        for dst, backup in reversed(backups):
            if backup is not None and os.path.exists(backup):
                os.replace(backup, dst)
        raise
    else:
        for _, backup in backups:
            if backup is not None:
                os.unlink(backup)


def main():
    parser = argparse.ArgumentParser(description="Capture reference fixtures from upstream Pi")
    parser.add_argument("--milestone", required=True, help="Milestone to capture (e.g. M1a)")
    args = parser.parse_args()
    
    print(f"Capturing fixtures for milestone: {args.milestone}")

    try:
        manifest = load_manifest()
    except Exception as e:
        print(f"Failed to load manifest: {e}")
        sys.exit(1)

    req_cases = manifest.get("requiredCaseIds", {})
    if args.milestone not in req_cases:
        print(f"Error: Milestone '{args.milestone}' is not defined in manifest requiredCaseIds")
        sys.exit(1)
        
    cases_catalog = manifest.get("cases", {})
    upstream_selected = [cid for cid in req_cases[args.milestone] if cases_catalog.get(cid, {}).get("oracle") == "upstream-pi"]
    invariant_selected = [cid for cid in req_cases[args.milestone] if cases_catalog.get(cid, {}).get("oracle") == "pi-rs-invariant"]

    for cid in invariant_selected:
        print(f"Skipping pi-rs-invariant case: {cid} (handled by invariant spec stubs)")

    if not upstream_selected:
        print(f"No upstream-pi cases selected for milestone '{args.milestone}'; nothing to capture.", file=sys.stderr)
        sys.exit(0)

    capture_root = os.environ.get("PI_UPSTREAM_ROOT")
    if not capture_root:
        print("Error: PI_UPSTREAM_ROOT environment variable must point to the checked-out Pi reference directory before capture.", file=sys.stderr)
        sys.exit(2)

    fixtures_dir = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "fixtures", "upstream-pi")
    hashes = []
    staged_updates = []

    # Keep staging on the destination filesystem so each publish rename is atomic.
    with tempfile.TemporaryDirectory(prefix="capture_stage_", dir=os.path.dirname(fixtures_dir)) as temp_stage_dir:
        for cid in upstream_selected:
            adapter = ADAPTERS.get(cid)
            if not adapter:
                print(f"Error: No adapter implemented for case '{cid}'", file=sys.stderr)
                sys.exit(1)

            print(f"Capturing upstream case: {cid}...")
            try:
                res_data = adapter(capture_root)
            except Exception as exc:
                print(f"Capture failed for {cid}: {exc}", file=sys.stderr)
                sys.exit(1)

            expected_temp_path = os.path.join(temp_stage_dir, f"{cid}.expected.json")
            with open(expected_temp_path, "w") as f:
                json.dump(res_data, f, indent=2)
                f.write("\n")

            content_bytes = json.dumps(res_data, sort_keys=True).encode("utf-8")
            raw_hash = hashlib.sha256(content_bytes).hexdigest()
            hash_temp_path = os.path.join(temp_stage_dir, f"{cid}.raw-hash.txt")
            with open(hash_temp_path, "w") as f:
                f.write(f"{raw_hash}\n")

            hashes.append(raw_hash)
            cases_catalog[cid]["captured"] = True

            staged_updates.append((expected_temp_path, os.path.join(fixtures_dir, f"{cid}.expected.json")))
            staged_updates.append((hash_temp_path, os.path.join(fixtures_dir, f"{cid}.raw-hash.txt")))

        capture_env = manifest.get("captureEnvironment", {})
        capture_env["host"] = get_tool_version(["uname", "-m"]) or "unknown"
        capture_env["nodeVersion"] = get_tool_version(["node", "--version"]) or "unknown"
        capture_env["bunVersion"] = get_tool_version(["bun", "--version"]) or "unknown"
        capture_env["capturedAt"] = datetime.datetime.now(datetime.timezone.utc).isoformat()

        combined_hash = hashlib.sha256("".join(sorted(hashes)).encode("utf-8")).hexdigest()
        capture_env["digest"] = f"sha256:{combined_hash}"
        all_milestone_cases = req_cases[args.milestone]
        captured_cases = [cid for cid in all_milestone_cases if cases_catalog.get(cid, {}).get("captured")]
        capture_env["captureStatus"] = (
            "completed" if len(captured_cases) == len(all_milestone_cases) else "partial"
        )

        manifest_temp_path = os.path.join(temp_stage_dir, "manifest.json")
        with open(manifest_temp_path, "w") as f:
            json.dump(manifest, f, indent=2)
            f.write("\n")

        # Publish with backups. A failed rename restores every destination file.
        publish_staged(staged_updates + [(manifest_temp_path, MANIFEST_PATH)])

    print(f"Reference capture complete for milestone {args.milestone}.")


if __name__ == "__main__":
    main()
