#!/usr/bin/env bash
set -euo pipefail

# Scripts/verify-release-artifacts
# Helper script to verify release artifacts and SHA256 checksums in dist/ directory.

DIST_DIR="${1:-dist}"

if [ ! -d "$DIST_DIR" ]; then
    echo "Error: dist directory not found at $DIST_DIR"
    exit 1
fi

if [ ! -f "$DIST_DIR/SHA256SUMS" ]; then
    echo "Error: SHA256SUMS not found in $DIST_DIR"
    exit 1
fi

cd "$DIST_DIR"
if command -v sha256sum >/dev/null 2>&1; then
    sha256sum -c SHA256SUMS
elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 -c SHA256SUMS
else
    echo "Error: Neither sha256sum nor shasum is available"
    exit 1
fi

echo "All release artifacts in $DIST_DIR verified successfully."
