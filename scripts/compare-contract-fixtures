#!/usr/bin/env python3
import sys
import os
import argparse
import json
from contract_fixture_lib import (
    canonical_json_sha256,
    compare_structures,
    load_manifest,
    validate_expected_envelope,
    validate_manifest,
)

def run_self_test():
    print("Running comparator self-test...")
    
    # Base structure
    expected = {
        "uuid": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
        "timestamp": "2026-07-27T12:34:56.789Z",
        "parent_id": "00000000-1111-2222-3333-444455556666",
        "messages": [
            {
                "role": "user",
                "content": "Hello"
            },
            {
                "role": "assistant",
                "stop_reason": "stop",
                "content": "Hi",
                "tool_calls": [
                    {"id": "call_1", "type": "function", "function": {"name": "read"}},
                    {"id": "call_2", "type": "function", "function": {"name": "bash"}}
                ]
            }
        ]
    }
    
    # 1. Mutate role
    mutated_role = json.loads(json.dumps(expected))
    mutated_role["messages"][0]["role"] = "assistant"
    diff_role = compare_structures(expected, mutated_role)
    if diff_role is None:
        print("Self-test FAILED: Mutated role was not detected.")
        return False
    print(" - Mutated role correctly detected:")
    print(f"   {diff_role.replace(chr(10), chr(10)+'   ')}")
    
    # 2. Mutate stop reason
    mutated_stop = json.loads(json.dumps(expected))
    mutated_stop["messages"][1]["stop_reason"] = "length"
    diff_stop = compare_structures(expected, mutated_stop)
    if diff_stop is None:
        print("Self-test FAILED: Mutated stop reason was not detected.")
        return False
    print(" - Mutated stop reason correctly detected:")
    print(f"   {diff_stop.replace(chr(10), chr(10)+'   ')}")
    
    # 3. Mutate tool order
    mutated_order = json.loads(json.dumps(expected))
    mutated_order["messages"][1]["tool_calls"] = [
        {"id": "call_2", "type": "function", "function": {"name": "bash"}},
        {"id": "call_1", "type": "function", "function": {"name": "read"}}
    ]
    diff_order = compare_structures(expected, mutated_order)
    if diff_order is None:
        print("Self-test FAILED: Mutated tool order was not detected.")
        return False
    print(" - Mutated tool order correctly detected:")
    print(f"   {diff_order.replace(chr(10), chr(10)+'   ')}")
    
    # 4. Mutate session parent ID
    mutated_parent = json.loads(json.dumps(expected))
    mutated_parent["parent_id"] = "99999999-9999-9999-9999-999999999999"
    diff_parent = compare_structures(expected, mutated_parent)
    if diff_parent is None:
        print("Self-test FAILED: Mutated session parent ID was not detected.")
        return False
    print(" - Mutated session parent ID correctly detected:")
    print(f"   {diff_parent.replace(chr(10), chr(10)+'   ')}")
    
    print("Comparator self-test PASSED")
    return True

def main():
    parser = argparse.ArgumentParser(description="Compare contract fixtures against actual output files")
    parser.add_argument("--milestone", help="Milestone to compare (e.g. M1a)")
    parser.add_argument("--self-test", action="store_true", help="Run comparator self-tests")
    parser.add_argument("--actual", help="Directory containing actual output files (required unless --self-test is specified)")
    parser.add_argument("--invariant-only", action="store_true", help="Compare only pi-rs-invariant cases")
    parser.add_argument("--exclude-case", action="append", default=[], help="Exclude case ID from comparison")
    args = parser.parse_args()
    
    if args.self_test:
        success = run_self_test()
        sys.exit(0 if success else 1)
        
    if not args.milestone:
        parser.error("--milestone is required unless --self-test is specified")
    if not args.actual:
        parser.error("--actual directory is required unless --self-test is specified")
        
    try:
        manifest = load_manifest()
        manifest_errors = validate_manifest(manifest)
        if manifest_errors:
            for error in manifest_errors:
                print(f"Manifest error: {error}")
            sys.exit(2)
        req_cases = manifest.get("requiredCaseIds", {})
        cases = manifest.get("cases", {})
        
        target_milestones = [args.milestone]
        
        has_errors = False
        skipped_count = 0
        failed_count = 0
        passed_count = 0
        
        for m in target_milestones:
            if m not in req_cases:
                print(f"Error: Milestone '{m}' not defined in manifest requiredCaseIds")
                sys.exit(1)
                
            selected_cases = [
                cid for cid in req_cases[m]
                if cid not in args.exclude_case and (not args.invariant_only or cases.get(cid, {}).get("oracle") == "pi-rs-invariant")
            ]
            print(f"Comparing milestone {m}...")
            required_files = {f"{cid}.actual.json" for cid in selected_cases}
            actual_files = set(os.listdir(args.actual)) if os.path.exists(args.actual) else set()
            excluded_files = {f"{cid}.actual.json" for cid in args.exclude_case}
            for extra in sorted(actual_files - required_files - excluded_files):
                print(f"Case {extra}: ERROR - extra actual output file")
                has_errors = True
                failed_count += 1
            missing_cases = {name[:-12] for name in required_files - actual_files}
            for missing in sorted(required_files - actual_files):
                case_id = missing[:-12]
                if cases.get(case_id, {}).get("oracle") == "upstream-pi" and not cases.get(case_id, {}).get("captured", False):
                    continue
                print(f"Case {missing}: ERROR - actual output file missing")
                has_errors = True
                failed_count += 1
            for case_id in selected_cases:
                case_info = cases.get(case_id, {})
                oracle = case_info.get("oracle")
                captured = case_info.get("captured", False)
                
                fixture_dir = os.path.join(
                    os.path.dirname(os.path.dirname(__file__)),
                    "fixtures", "upstream-pi"
                )
                expected_file = os.path.join(fixture_dir, f"{case_id}.expected.json")
                actual_file = os.path.join(args.actual, f"{case_id}.actual.json")
                
                if not os.path.exists(expected_file):
                    print(f"Case {case_id}: ERROR - expected fixture file missing at {expected_file}")
                    has_errors = True
                    failed_count += 1
                    continue

                if oracle == "upstream-pi" and not captured:
                    print(f"Case {case_id}: REJECTED - required upstream case is pending capture")
                    has_errors = True
                    skipped_count += 1
                    continue
                if case_id in missing_cases:
                    continue

                try:
                    with open(expected_file, 'r', encoding='utf-8') as f:
                        expected_data = json.load(f)
                    with open(actual_file, 'r', encoding='utf-8') as f:
                        actual_data = json.load(f)
                except Exception as e:
                    print(f"Case {case_id}: ERROR - failed to load JSON files: {e}")
                    has_errors = True
                    failed_count += 1
                    continue
                    
                hash_file = os.path.join(fixture_dir, f"{case_id}.raw-hash.txt")
                if not os.path.exists(hash_file):
                    print(f"Case {case_id}: ERROR - raw-hash.txt missing at {hash_file}")
                    has_errors = True
                    failed_count += 1
                    continue
                actual_hash = canonical_json_sha256(expected_data)
                with open(hash_file, 'r', encoding='utf-8') as hf:
                    expected_hash = hf.read().strip()
                if actual_hash != expected_hash:
                    print(f"Case {case_id}: ERROR - raw-hash.txt mismatch (expected {expected_hash}, got {actual_hash})")
                    has_errors = True
                    failed_count += 1
                    continue

                if oracle == "pi-rs-invariant":
                    envelope_error = validate_expected_envelope(expected_data, case_id, oracle)
                    if envelope_error:
                        print(f"Case {case_id}: ERROR - {envelope_error}")
                        has_errors = True
                        failed_count += 1
                        continue
                    expected_payload = expected_data.get("expected")

                    expected_data = expected_payload
                norm_allowlist = case_info.get("normalizationAllowlist", [])
                diff = compare_structures(expected_data, actual_data, allowlist=norm_allowlist)
                if diff:
                    print(f"Case {case_id}: FAILED")
                    print(diff)
                    has_errors = True
                    failed_count += 1
                else:
                    print(f"Case {case_id}: PASSED")
                    passed_count += 1
                    
        print("\nSummary:")
        print(f" - Passed: {passed_count}")
        print(f" - Pending/Skipped: {skipped_count}")
        print(f" - Failed/Errors: {failed_count}")
        
        sys.exit(1 if has_errors else 0)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(2)

if __name__ == "__main__":
    main()
