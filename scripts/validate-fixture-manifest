#!/usr/bin/env python3
import sys
import argparse
from contract_fixture_lib import load_manifest, validate_manifest

def main():
    parser = argparse.ArgumentParser(description="Validate Pi compatibility fixture manifest")
    parser.add_argument("--milestone", help="Validate only this milestone, requiring all its cases to be captured")
    parser.add_argument("--fixtures-dir", help="Path to fixtures directory", default=None)
    args = parser.parse_args()

    try:
        manifest = load_manifest()
        fixtures_dir = args.fixtures_dir
        if fixtures_dir is None:
            # Default to fixtures/upstream-pi alongside manifest.json
            import os
            from contract_fixture_lib import MANIFEST_PATH
            fixtures_dir = os.path.dirname(MANIFEST_PATH)

        errors = validate_manifest(manifest, milestone=args.milestone, fixtures_dir=fixtures_dir)

        if errors:
            print("Manifest validation FAILED:")
            for err in errors:
                print(f" - {err}")
            sys.exit(1)

        print("Manifest validation PASSED")
        sys.exit(0)
    except Exception as e:
        print(f"Error: {e}")
        sys.exit(2)

if __name__ == "__main__":
    main()
